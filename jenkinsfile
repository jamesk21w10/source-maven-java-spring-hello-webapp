pipeline {
  agent {label 'jenkins-node'}
  triggers { pollSCM('* * 5 * *')}
  stages {
    stage ('checkout')  {
        steps {            
            git branch: 'main',
            url: 'https://github.com/jamesk21w10/source-maven-java-spring-hello-webapp.git'
        }
    }
    stage ('build')  {
        steps {            
            sh 'mvn clean package'
        }
    }

    stage ('deploy')  {
        steps {            
            deploy adapters: [tomcat9(credentialsId:'tomcat-user', url:'http://192.168.153.102:8080')], contextPath: null, war: 'target/*.war'
        }
    }
  }
}